{
  "name": "@kaiachain/system-contracts-v1.0",
  "version": "0.0.1",
  "description": "Kaia System Contracts v1.0",
  "author": "Kaia Team",
  "license": "LGPL-3.0",
  "homepage": "https://github.com/kaiachain/system-contracts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaiachain/system-contracts.git",
    "directory": "contracts-v1.0"
  },
  "bugs": {
    "url": "https://github.com/kaiachain/system-contracts/issues"
  },
  "keywords": [
    "kaia",
    "smart-contracts",
    "solidity",
    "ethereum",
    "blockchain"
  ],
  "files": [
    "contracts/**/*.sol",
    "artifacts/contracts/**/*.json",
    "!artifacts/contracts/**/*.dbg.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf artifacts cache typechain-types",
    "compile": "npx hardhat compile",
    "build": "tsc",
    "test": "npx hardhat test",
    "lint": "npm run lint:js && npm run lint:sol",
    "lint:fix": "npm run lint:js:fix && npm run lint:sol:fix",
    "lint:js": "prettier --loglevel warn --ignore-path .gitignore '**/*.{js,ts}' --check && eslint --no-error-on-unmatched-pattern --ignore-path .gitignore .",
    "lint:js:fix": "prettier --loglevel warn --ignore-path .gitignore '**/*.{js,ts}' --write && eslint --no-error-on-unmatched-pattern --ignore-path .gitignore . --fix",
    "lint:sol": "prettier --loglevel warn --ignore-path .gitignore '{contracts,test,script}/**/*.sol' --check && solhint '{contracts,test,script}/**/*.sol'",
    "lint:sol:fix": "prettier --loglevel warn --ignore-path .gitignore '{contracts,test,script}/**/*.sol' --write",
    "watch": "tsc -w"
  },
  "devDependencies": {
    "@kaiachain/system-contracts-common": "file:../common",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/solidity-analyzer": "^0.1.2",
    "@openzeppelin/hardhat-upgrades": "3.9.0",
    "@primitivefi/hardhat-dodoc": "^0.2.3",
    "hardhat": "^2.23.0",
    "hardhat-deploy": "^1.0.2",
    "openzeppelin-contracts-4.0": "npm:@openzeppelin/contracts@^4.6.0",
    "openzeppelin-contracts-5.0": "npm:@openzeppelin/contracts@^5.0.2",
    "openzeppelin-contracts-upgradeable-4.0": "npm:@openzeppelin/contracts-upgradeable@^4.9.3",
    "openzeppelin-contracts-upgradeable-5.0": "npm:@openzeppelin/contracts-upgradeable@^5.0.2",
    "prettier": "^2.8.7",
    "prettier-plugin-solidity": "^1.1.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4",
    "dotenv": "^17.2.3"
  },
  "dependencies": {}
}
